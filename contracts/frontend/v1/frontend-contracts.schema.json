{
  "$defs": {
    "EventPage": {
      "additionalProperties": false,
      "description": "A reconnectable, cursor-addressed page from the backend event stream.",
      "properties": {
        "cursor": {
          "minimum": 0,
          "title": "Cursor",
          "type": "integer"
        },
        "events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FrontendEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "gapDetected": {
          "default": false,
          "title": "Gapdetected",
          "type": "boolean"
        },
        "refreshRequired": {
          "default": false,
          "title": "Refreshrequired",
          "type": "boolean"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "cursor"
      ],
      "title": "EventPage",
      "type": "object"
    },
    "FrontendApproval": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "additionalProperties": true,
          "title": "Action",
          "type": "object"
        },
        "approvalId": {
          "title": "Approvalid",
          "type": "string"
        },
        "resources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Resources",
          "type": "array"
        },
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "revoked"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "approvalId",
        "runId",
        "state"
      ],
      "title": "FrontendApproval",
      "type": "object"
    },
    "FrontendArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "title": "Artifactid",
          "type": "string"
        },
        "contentHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contenthash"
        },
        "mediaType": {
          "title": "Mediatype",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifactId",
        "version",
        "mediaType"
      ],
      "title": "FrontendArtifact",
      "type": "object"
    },
    "FrontendCapabilities": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "title": "Apiversion",
          "type": "string"
        },
        "eventResume": {
          "default": true,
          "title": "Eventresume",
          "type": "boolean"
        },
        "eventStream": {
          "const": "sse",
          "default": "sse",
          "title": "Eventstream",
          "type": "string"
        },
        "nativeResources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Nativeresources",
          "type": "array"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "apiVersion"
      ],
      "title": "FrontendCapabilities",
      "type": "object"
    },
    "FrontendError": {
      "additionalProperties": false,
      "description": "Stable error envelope exposed to every frontend transport.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "correlationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlationid"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "error": {
          "title": "Error",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "error"
      ],
      "title": "FrontendError",
      "type": "object"
    },
    "FrontendEvent": {
      "additionalProperties": false,
      "properties": {
        "agentSessionId": {
          "title": "Agentsessionid",
          "type": "string"
        },
        "cursor": {
          "minimum": 0,
          "title": "Cursor",
          "type": "integer"
        },
        "eventId": {
          "title": "Eventid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "session.ready",
            "turn.accepted",
            "assistant.delta",
            "run.status",
            "approval.requested",
            "approval.committed",
            "artifact.available",
            "usage.updated",
            "stream.end"
          ],
          "title": "Kind",
          "type": "string"
        },
        "occurredAt": {
          "format": "date-time",
          "title": "Occurredat",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "runId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runid"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "eventId",
        "cursor",
        "kind",
        "occurredAt",
        "projectId",
        "agentSessionId"
      ],
      "title": "FrontendEvent",
      "type": "object"
    },
    "FrontendRun": {
      "additionalProperties": false,
      "properties": {
        "attemptCount": {
          "default": 0,
          "minimum": 0,
          "title": "Attemptcount",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrontendError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "requestedAction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requestedaction"
        },
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "state": {
          "enum": [
            "accepted",
            "queued",
            "running",
            "awaiting_approval",
            "succeeded",
            "failed",
            "cancelled",
            "timed_out",
            "partially_succeeded"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "runId",
        "projectId",
        "state"
      ],
      "title": "FrontendRun",
      "type": "object"
    },
    "FrontendSession": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "title": "Actorid",
          "type": "string"
        },
        "agentSessionId": {
          "title": "Agentsessionid",
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/FrontendCapabilities"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        },
        "mode": {
          "enum": [
            "local",
            "hosted",
            "mock"
          ],
          "title": "Mode",
          "type": "string"
        },
        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "sessionId": {
          "title": "Sessionid",
          "type": "string"
        },
        "workspaceId": {
          "title": "Workspaceid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "projectId",
        "agentSessionId",
        "workspaceId",
        "actorId",
        "mode",
        "capabilities",
        "issuedAt"
      ],
      "title": "FrontendSession",
      "type": "object"
    },
    "FrontendUsage": {
      "additionalProperties": false,
      "properties": {
        "actualCost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actualcost"
        },
        "estimatedCost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedcost"
        },
        "inputTokens": {
          "default": 0,
          "minimum": 0,
          "title": "Inputtokens",
          "type": "integer"
        },
        "outputTokens": {
          "default": 0,
          "minimum": 0,
          "title": "Outputtokens",
          "type": "integer"
        },
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        }
      },
      "required": [
        "runId"
      ],
      "title": "FrontendUsage",
      "type": "object"
    },
    "PromptAcceptance": {
      "additionalProperties": false,
      "properties": {
        "acceptedAt": {
          "format": "date-time",
          "title": "Acceptedat",
          "type": "string"
        },
        "agentSessionId": {
          "title": "Agentsessionid",
          "type": "string"
        },
        "assistantMessageId": {
          "title": "Assistantmessageid",
          "type": "string"
        },
        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "requestId": {
          "title": "Requestid",
          "type": "string"
        },
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "default": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "userMessageId": {
          "title": "Usermessageid",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "projectId",
        "agentSessionId",
        "userMessageId",
        "assistantMessageId",
        "runId",
        "acceptedAt"
      ],
      "title": "PromptAcceptance",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/FrontendSession"
    },
    {
      "$ref": "#/$defs/PromptAcceptance"
    },
    {
      "$ref": "#/$defs/FrontendEvent"
    },
    {
      "$ref": "#/$defs/EventPage"
    },
    {
      "$ref": "#/$defs/FrontendError"
    },
    {
      "$ref": "#/$defs/FrontendRun"
    },
    {
      "$ref": "#/$defs/FrontendApproval"
    },
    {
      "$ref": "#/$defs/FrontendArtifact"
    },
    {
      "$ref": "#/$defs/FrontendUsage"
    }
  ]
}
