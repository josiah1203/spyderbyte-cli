{
  "name": "@agentic-platform/cloud-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@agentic-platform/artifact-registry": "workspace:*",
    "@agentic-platform/backends": "workspace:*",
    "@agentic-platform/runtime-contracts": "workspace:*",
    "@agentic-platform/runtime-domain": "workspace:*",
    "@agentic-platform/state": "workspace:*",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ../../scripts/verify/lint-package.mjs",
    "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
    "test:integration": "vitest run --passWithNoTests --config ../../vitest.integration.config.ts",
    "test:invariants": "vitest run --passWithNoTests --config ../../vitest.invariants.config.ts"
  }
}
