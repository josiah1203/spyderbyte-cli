{
  "name": "agentic-ml-data-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && node scripts/verify/check-boundaries.mjs",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:invariants": "turbo run test:invariants",
    "dev:up": "bash scripts/dev-up",
    "dev:down": "bash scripts/dev-down",
    "dev:reset": "bash scripts/dev-reset",
    "dev:health": "bash scripts/dev-health",
    "contracts:generate": "node scripts/verify/generate-contracts.mjs",
    "contracts:check": "node scripts/verify/generate-contracts.mjs --check",
    "api-contracts:generate": "node scripts/verify/generate-api-contract.mjs",
    "api-contracts:check": "node scripts/verify/generate-api-contract.mjs --check",
    "frontend-contracts:generate": "node scripts/verify/generate-frontend-contract-snapshot.mjs",
    "frontend-contracts:check": "node scripts/verify/generate-frontend-contract-snapshot.mjs --check",
    "verify:phase11": "node scripts/verify/check-phase11-local.mjs",
    "verify:containers": "node scripts/verify/check-container-images.mjs",
    "codex:migration:generate": "node scripts/verify/generate-codex-migration-matrix.mjs",
    "codex:migration:check": "node scripts/verify/generate-codex-migration-matrix.mjs --check",
    "codex:migration:audit": "node scripts/verify/check-codex-phase-zero.mjs",
    "release:macos": "bash scripts/release/check-macos-release.sh",
    "release:platform": "node scripts/release/build-platform-release.mjs",
    "release:manifest": "node scripts/release/write-platform-release-manifest.mjs",
    "release:manifest:verify": "node scripts/release/verify-platform-release-manifest.mjs",
    "dev:frontend": "bash scripts/view-frontend.sh",
    "dev:license": "node scripts/dev/create-development-license.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm contracts:check && pnpm api-contracts:check && pnpm frontend-contracts:check && pnpm codex:migration:check && pnpm codex:migration:audit && pnpm verify:phase11 && pnpm verify:containers && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:invariants && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/node": "22.10.5",
    "eslint": "9.30.1",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "turbo": "2.9.14",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
